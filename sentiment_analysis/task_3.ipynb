        "no_decay = [\"bias\", \"LayerNorm.weight\"]\n",
        "groups = [\n",
        "    {\"params\": [p for n, p in model.named_parameters() if not any(k in n for k in no_decay)], \"weight_decay\": CFG[\"weight_decay\"]},\n",
        "    {\"params\": [p for n, p in model.named_parameters() if any(k in n for k in no_decay)], \"weight_decay\": 0.0},\n",
        "]\n",
        "opt = torch.optim.AdamW(groups, lr=CFG[\"lr\"])\n",
        "total = ((len(tr_ids) + CFG[\"bs\"] - 1) // CFG[\"bs\"]) * CFG[\"epochs\"]\n",
        "sched = get_linear_schedule_with_warmup(opt, int(CFG[\"warmup\"] * total), total)\n",
        "scaler = torch.amp.GradScaler(); loss_fn = torch.nn.CrossEntropyLoss()\n",
        "\n",
        "best, step, hist, t0 = -1.0, 0, [], time.time()\n",
        "model.train()\n",
        "for ep in range(CFG[\"epochs\"]):\n",
        "    run = 0.0\n",
        "    if ep > 0:                                    # fresh balanced sample for this epoch (high-count classes: new rows)\n",
        "        tr_df = balanced_epoch(ep); tr_ids = enc(tr_df); tr_y = tr_df[\"overall\"].values - 1\n",
        "        print(f\"epoch {ep}: new balanced sample, {len(tr_ids)} rows\")\n",
        "    for bidx in train_batches(CFG[\"bs\"]):\n",
        "        x, m = collate([tr_ids[i] for i in bidx]); y = torch.tensor(tr_y[bidx], device=dev)\n",
        "        with torch.autocast(\"cuda\", dtype=torch.float16):\n",
        "            logits = model(input_ids=x, attention_mask=m).logits\n",
        "        loss = loss_fn(logits.float(), y)\n",
        "        scaler.scale(loss).backward(); scaler.unscale_(opt)\n",
        "        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
        "        scaler.step(opt); scaler.update(); opt.zero_grad(set_to_none=True); sched.step()\n",
        "        step += 1; run += loss.item()\n",
        "        if step % 200 == 0:\n",
        "            el = time.time() - t0\n",
        "            print(f\"ep {ep} step {step}/{total} loss {run / 200:.4f} | {el / 60:.1f}m, eta {(total - step) * el / step / 60:.1f}m\"); run = 0.0\n",
        "        if step % CFG[\"eval_every\"] == 0 or step == total:\n",
        "            f1 = f1_score(val_y, predict_logits(val_ids).argmax(1), average=\"micro\")\n",
        "            hist.append((step, f1)); print(f\"=== step {step}: val micro-F1 = {f1:.4f}\")\n",
        "            if f1 > best:\n",
        "                best = f1; torch.save(model.state_dict(), \"best.pt\")\n",
        "print(\"best val micro-F1:\", best)\n",
        "print(f\"unique training rows seen: {len(used_rows)} of {sum(len(p) for p in pools.values())} available ({len(used_rows) / sum(len(p) for p in pools.values()) * 100:.0f}%)\")"
      ]
