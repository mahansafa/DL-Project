        "model = AutoModelForSequenceClassification.from_pretrained(CFG[\"model\"], num_labels=5).to(dev)\n",
        "print(f\"{sum(p.numel() for p in model.parameters()) / 1e6:.1f}M parameters\")\n",
        "\n",
        "def collate(seqs):\n",
        "    L = max(len(s) for s in seqs)\n",
        "    ids = torch.full((len(seqs), L), tok.pad_token_id, dtype=torch.long)\n",
        "    mask = torch.zeros((len(seqs), L), dtype=torch.long)\n",
        "    for i, s in enumerate(seqs):\n",
        "        ids[i, : len(s)] = torch.tensor(s); mask[i, : len(s)] = 1\n",
        "    return ids.to(dev), mask.to(dev)\n",
        "\n",
        "def train_batches(bs):\n",
        "    # randomize + sort within chunks of 50 batches → little padding but still random\n",
        "    idx = np.random.permutation(len(tr_ids)); chunk = bs * 50; out = []\n",
        "    for c in range(0, len(idx), chunk):\n",
        "        part = sorted(idx[c: c + chunk], key=lambda i: len(tr_ids[i]))\n",
        "        out += [part[b: b + bs] for b in range(0, len(part), bs)]\n",
        "    random.shuffle(out); return out\n",
        "\n",
        "@torch.no_grad()\n",
        "def predict_logits(ids_list, bs=128):\n",
        "    model.eval(); order = np.argsort([len(s) for s in ids_list]); out = np.zeros((len(ids_list), 5), np.float32)\n",
        "    for b in range(0, len(order), bs):\n",
        "        sel = order[b: b + bs]; x, m = collate([ids_list[i] for i in sel])\n",
        "        with torch.autocast(\"cuda\", dtype=torch.float16):\n",
        "            out[sel] = model(input_ids=x, attention_mask=m).logits.float().cpu().numpy()\n",
        "    model.train(); return out"
