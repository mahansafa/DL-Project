        "from sklearn.feature_extraction.text import ENGLISH_STOP_WORDS, TfidfVectorizer\n",
        "from sklearn.svm import LinearSVC\n",
        "from scipy.sparse import hstack\n",
        "\n",
        "ab = df.dropna(subset=[\"reviewText\"]).sample(60_000, random_state=7)\n",
        "ab = ab.assign(text=ab.reviewText.map(clean_text), summ=ab.summary.fillna(\"\").map(clean_text))\n",
        "a_tr, a_va = ab.iloc[:48_000], ab.iloc[48_000:]\n",
        "KEEP = {\"not\", \"no\", \"nor\", \"never\", \"none\", \"nothing\", \"cannot\", \"but\", \"very\", \"too\", \"only\", \"really\", \"against\",\n",
        "        \"don\", \"doesn\", \"didn\", \"isn\", \"wasn\", \"won\", \"wouldn\", \"couldn\", \"shouldn\", \"aren\", \"weren\", \"hasn\", \"haven\", \"hadn\"}\n",
        "SAFE_STOP = sorted(ENGLISH_STOP_WORDS - KEEP)\n",
        "TP = r\"(?u)\\b\\w+\\b|[!?]\"\n",
        "\n",
        "def ablate(name, use_summary, stop_words):\n",
        "    v = TfidfVectorizer(ngram_range=(1, 2), min_df=3, max_features=200_000, sublinear_tf=True, stop_words=stop_words, token_pattern=TP)\n",
        "    Xtr, Xva = v.fit_transform(a_tr.text), v.transform(a_va.text)\n",
        "    if use_summary:\n",
        "        vs = TfidfVectorizer(ngram_range=(1, 2), min_df=2, sublinear_tf=True, stop_words=stop_words, token_pattern=TP)\n",
        "        Xtr, Xva = hstack([Xtr, vs.fit_transform(a_tr.summ)]).tocsr(), hstack([Xva, vs.transform(a_va.summ)]).tocsr()\n",
        "    f1 = f1_score(a_va.overall, LinearSVC(C=0.3).fit(Xtr, a_tr.overall).predict(Xva), average=\"micro\")\n",
        "    return {\"Preprocessing\": name, \"val micro-F1\": round(f1, 4)}\n",
        "\n",
        "pd.DataFrame([\n",
        "    ablate(\"A) text only, all words\", False, None),\n",
        "    ablate(\"B) text only, remove sklearn stop words (naive)\", False, \"english\"),\n",
        "    ablate(\"C) text only, remove stop words except negations/intensifiers\", False, SAFE_STOP),\n",
        "    ablate(\"D) text + summary, all words\", True, None),\n",
        "])"
      ]
    },
