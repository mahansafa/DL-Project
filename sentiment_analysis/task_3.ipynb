      "source": [
        "df = df.dropna(subset=[\"reviewText\", \"overall\"])\n",
        "df[\"overall\"] = df[\"overall\"].astype(int)\n",
        "prior = df.overall.value_counts(normalize=True).sort_index().values      # natural training distribution (for the supplementary report)\n",
        "\n",
        "# Fixed balanced validation: per_val random samples from each class (fixed seed). The remaining rows of each class = that class's \"training pool\".\n",
        "per_val = CFG[\"n_val\"] // 5\n",
        "val_parts, pools = [], {}\n",
        "for k, g in df.groupby(\"overall\"):\n",
        "    g = g.sample(frac=1, random_state=CFG[\"seed\"])                     # random shuffle\n",
        "    val_parts.append(g.iloc[:per_val])\n",
        "    pools[k] = g.iloc[per_val:]                                        # no row is in both validation and training\n",
        "val_df = pd.concat(val_parts).sample(frac=1, random_state=CFG[\"seed\"]).reset_index(drop=True)\n",
        "\n",
        "# Number of samples per class in each epoch: equal for all, equal to the smallest pool (class 2) or the cap n_train/5\n",
        "per_cls = min(CFG[\"n_train\"] // 5, min(len(p) for p in pools.values()))\n",
        "used_rows = set()                                                      # count of unique rows seen during training\n",
        "\n",
        "def balanced_epoch(ep):\n",
        "    \"\"\"Balanced sample for epoch number ep: the ep-th slice of each class's pool; for high-count classes the samples of each epoch differ from the previous epoch\n",
        "    (for low-count classes, after the pool is exhausted, we continue from its start).\"\"\"\n",
        "    parts = []\n",
        "    for k, pool in pools.items():\n",
        "        idx = (np.arange(per_cls) + ep * per_cls) % len(pool)\n",
        "        parts.append(pool.iloc[idx])\n",
        "    d = pd.concat(parts)\n",
        "    used_rows.update(d.index)\n",
        "    return d.sample(frac=1, random_state=CFG[\"seed\"] + ep).reset_index(drop=True)\n",
        "\n",
        "tr_df = balanced_epoch(0)\n",
        "print(\"train class counts per epoch:\", tr_df.overall.value_counts().sort_index().to_dict())\n",
        "print(\"val   class counts:\", val_df.overall.value_counts().sort_index().to_dict())\n",
        "t0 = time.time()\n",
        "enc = lambda d: [encode_review(s, r) for s, r in zip(d[\"summary\"], d[\"reviewText\"])]\n",
        "tr_ids, val_ids, te_ids = enc(tr_df), enc(val_df), enc(test_df)\n",
        "tr_y, val_y = tr_df[\"overall\"].values - 1, val_df[\"overall\"].values - 1\n",
        "print(f\"train {len(tr_ids)} | val {len(val_ids)} | test {len(te_ids)} | tokenised in {time.time() - t0:.0f}s\")"
      ]
