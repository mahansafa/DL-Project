        "_TAG, _URL = re.compile(r\"<[^>]+>\"), re.compile(r\"https?://\\S+|www\\.\\S+\")\n",
        "_REPEAT, _SPACES = re.compile(r\"(.)\\1{3,}\"), re.compile(r\"\\s+\")\n",
        "\n",
        "def clean_text(text):\n",
        "    if not isinstance(text, str):\n",
        "        return \"\"\n",
        "    text = html.unescape(text)\n",
        "    text = _TAG.sub(\" \", text)\n",
        "    text = _URL.sub(\" url \", text)\n",
        "    text = _REPEAT.sub(r\"\\1\\1\\1\", text)\n",
        "    return _SPACES.sub(\" \", text).strip()\n",
        "\n",
        "tok = AutoTokenizer.from_pretrained(CFG[\"model\"])\n",
        "\n",
        "def encode_review(summary, review):\n",
        "    \"\"\"<s> summary </s></s> review(head ... tail) </s>  with a max_len token cap.\"\"\"\n",
        "    s_ids = tok.encode(clean_text(summary), add_special_tokens=False)[: CFG[\"max_summary\"]]\n",
        "    r_ids = tok.encode(clean_text(review), add_special_tokens=False)\n",
        "    budget = CFG[\"max_len\"] - 4 - len(s_ids)          # 4 special tokens: <s>, </s>, </s>, </s>\n",
        "    if len(r_ids) > budget:\n",
        "        head = int(budget * CFG[\"head_frac\"]); tail = budget - head\n",
        "        r_ids = r_ids[:head] + (r_ids[-tail:] if tail > 0 else [])\n",
        "    cls, sep = tok.cls_token_id, tok.sep_token_id     # RoBERTa pair format: <s> A </s></s> B </s>\n",
        "    return [cls] + s_ids + [sep, sep] + r_ids + [sep]\n",
